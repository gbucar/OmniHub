# Database role passwords (run scripts/generate-env.sh to create a secure .env)
POSTGRES_PASSWORD=change-me-postgres
POSTGREST_DB_PASSWORD=change-me-postgrest
PIPELINE_DB_PASSWORD=change-me-pipeline
AUTH_DB_PASSWORD=change-me-auth
RESEARCHER_DB_PASSWORD=change-me-researcher

# Ports
DB_PORT=5432
PGRST_PORT=3000

# Publicly reachable PostgREST URL (update this for your remote server)
POSTGREST_URL=http://localhost:3000

# Connection strings used by PostgREST and the pipeline
PGRST_DB_URI=postgres://postgrest:change-me-postgrest@db:5432/postgres
PIPELINE_CONNECTION_STRING=postgres://pipeline:change-me-pipeline@db:5432/postgres

# JWT configuration used by PostgREST and api.login()
PGRST_JWT_SECRET=change-me-to-a-64-char-hex-secret-or-run-generate-env-sh
POSTGREST_JWT_DURATION_SECONDS=3600

# Initial admin user created on first DB initialisation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Atmotube API key (required for the pipeline)
ATMOTUBE_API_KEY=
